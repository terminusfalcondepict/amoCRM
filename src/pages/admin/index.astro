---
// Админка. Доступ проверяет src/middleware.js (без входа — редирект на /admin/login).
// Данные лежат в Supabase: стартовые значения сервер кладёт в страницу,
// а сохранение идёт через /admin/api/content/<раздел> (src/scripts/admin/store.js).
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../../styles/global.css';
import '../../styles/admin.css';
import { getContent } from '../../lib/content/repo.js';

export const prerender = false;

let content = null;
try {
  content = await getContent();
} catch (e) {
  console.error(e);
  Astro.response.status = 503;
}

// JSON внутри <script>: экранируем «<», чтобы текст из кейсов не мог закрыть тег.
const seed = content ? JSON.stringify(content).replace(/</g, '\\u003c') : '';

const nav = [
  { id: 'hero', label: 'Главный экран', icon: '◧' },
  { id: 'services', label: 'Услуги', icon: '☰' },
  { id: 'cases', label: 'Кейсы', icon: '▤', count: true },
  { id: 'seo', label: 'SEO', icon: '⌕' },
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Админка</title>
</head>
<body class="adm is-loading">
  <a class="adm-skip" href="#adm-main">К содержимому</a>

  <header class="adm-top">
    <p class="adm-brand">Админка сайта</p>
    <div class="adm-top__actions">
      <a class="adm-btn adm-btn--small adm-btn--ghost" href="/" target="_blank" rel="noopener">Открыть сайт ↗</a>
      <form method="post" action="/admin/logout">
        <button class="adm-btn adm-btn--small adm-btn--ghost" type="submit">Выйти</button>
      </form>
    </div>
  </header>

  <div class="adm-layout">
    <nav class="adm-nav" aria-label="Разделы админки">
      {nav.map((n) => (
        <a class="adm-nav__link" href={`#${n.id}`} data-nav={n.id}>
          <span class="adm-nav__icon" aria-hidden="true">{n.icon}</span>
          <span>{n.label}</span>
          {n.count && <span class="adm-nav__count" data-cases-count>{content?.cases.length ?? 0}</span>}
        </a>
      ))}
      <div class="adm-nav__foot">
        <p class="adm-notice">После сохранения изменения появляются на сайте через 1–2 минуты.</p>
      </div>
    </nav>

    <main class="adm-main" id="adm-main">
      {content
        ? <p class="adm-loading">Загружаем данные…</p>
        : <section class="adm-section">
            <h1 class="adm-section__title">Не удалось загрузить данные</h1>
            <p class="adm-section__lead">База данных сейчас недоступна. Обновите страницу через минуту. Если ошибка повторяется — сообщите разработчику.</p>
          </section>}
    </main>
  </div>

  <div class="adm-savebar" data-savebar hidden>
    <p class="adm-savebar__text">Есть несохранённые изменения</p>
    <div class="adm-savebar__actions">
      <button class="adm-btn" type="button" data-cancel>Отменить</button>
      <button class="adm-btn adm-btn--primary" type="button" data-save>Сохранить</button>
    </div>
  </div>

  {content && <script type="application/json" id="admin-seed" set:html={seed}></script>}
  <script src="../../scripts/admin/app.js"></script>
</body>
</html>
